# Rogue Night — Apache configuration for Hostinger Shared Hosting.
# Drop this file into public_html alongside index.html.

# Force HTTPS — Hostinger provisions Let's Encrypt SSL automatically.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force apex domain (drop www) — change to opposite if you prefer www
RewriteCond %{HTTP_HOST} ^www\.roguenight\.com\.au$ [NC]
RewriteRule ^(.*)$ https://roguenight.com.au/$1 [L,R=301]

# Pretty URLs — /privacy → /privacy/index.html, /terms → /terms/index.html
# DirectorySlash is on by default in Apache; the canonical link tags use /privacy/ and /terms/.

# Custom error pages
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS — only enable after confirming HTTPS works end-to-end (otherwise can
    # lock visitors out for up to 6 months). Uncomment 2 weeks after launch.
    # Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

# Compression — Hostinger usually has this on globally, but belt-and-braces.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml application/xml application/rss+xml application/atom+xml
</IfModule>

# Long cache for immutable assets (logos, OG image, PDF)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Prevent listing of directory contents
Options -Indexes
